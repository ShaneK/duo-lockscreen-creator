{
  "name": "duo-lockscreen-creator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 43187 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 43187 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:production": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config=playwright.production.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@ionic/react": "^9.0.10",
    "ionicons": "^8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  }
}
